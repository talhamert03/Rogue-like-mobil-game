{
  "name": "deckdelver",
  "private": true,
  "version": "1.0.0",
  "description": "Deckdelver — mobil roguelike kart zindan RPG",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vite-node scripts/simulate.ts",
    "e2e": "playwright test",
    "cap:sync": "npm run build && npx cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0"
  }
}
